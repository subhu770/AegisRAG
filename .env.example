# AegisRAG Configuration Environment Variables

AEGIS_PROJECT_NAME=AegisRAG
AEGIS_DEBUG=false
AEGIS_LOG_LEVEL=INFO

# Embedding Model
AEGIS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AEGIS_EMBEDDING_DEVICE=cpu

# Cross-Encoder Reranker
AEGIS_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
AEGIS_RERANKER_DEVICE=cpu

# Hybrid Search Defaults
AEGIS_DEFAULT_TOP_K=10
AEGIS_DEFAULT_RERANK_TOP_N=5
AEGIS_DEFAULT_RRF_K=60

# Vector Store
AEGIS_VECTOR_STORE_TYPE=chroma
AEGIS_CHROMA_PERSIST_DIRECTORY=./data/chroma_db
AEGIS_CHROMA_COLLECTION_NAME=aegis_enterprise_knowledge

# Generator Settings
AEGIS_GENERATOR_PROVIDER=local_synthesis
# Optional external LLM API keys:
# AEGIS_OPENAI_API_KEY=sk-...
# AEGIS_LLM_MODEL=gpt-4o-mini

